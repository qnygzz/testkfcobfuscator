-- SERVICES
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- GLOBAL TABLES
getgenv().Toggles = {}
getgenv().Options = {}
getgenv().OceanGUIName = "Ocean GUI"

-- THEME
local Theme = {
    Background = Color3.fromRGB(12,18,28),
    Section = Color3.fromRGB(16,25,38),
    Accent = Color3.fromRGB(0,170,255),
    Text = Color3.fromRGB(235,240,245),
    Muted = Color3.fromRGB(120,130,145),
    Stroke = Color3.fromRGB(35,55,80),
}

-- UTILS
local function Round(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,r)
    c.Parent = obj
end

local function Stroke(obj)
    local s = Instance.new("UIStroke")
    s.Color = Theme.Stroke
    s.Thickness = 1
    s.Parent = obj
end

local function CreateToggleButton(parent,text,default,callback)
    local Toggle = {}
    Toggle.Value = default or false

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,-16,0,36)
    Btn.BackgroundColor3 = Theme.Background
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.Parent = parent
    Round(Btn,10)
    Stroke(Btn)

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Text = text or ""
    TextLabel.Font = Enum.Font.Gotham
    TextLabel.TextSize = 13
    TextLabel.TextColor3 = Theme.Text
    TextLabel.BackgroundTransparency = 1
    TextLabel.Position = UDim2.fromOffset(12,0)
    TextLabel.Size = UDim2.new(1,-60,1,0)
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left
    TextLabel.Parent = Btn

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.fromOffset(22,22)
    Indicator.Position = UDim2.new(1,-32,0.5,-11)
    Indicator.BackgroundColor3 = Toggle.Value and Theme.Accent or Theme.Stroke
    Indicator.Parent = Btn
    Round(Indicator,6)

    function Toggle:SetValue(v)
        self.Value = v
        TweenService:Create(Indicator,TweenInfo.new(0.15),{BackgroundColor3 = v and Theme.Accent or Theme.Stroke}):Play()
        if callback then callback(v) end
    end

    function Toggle:OnChanged(fn)
        Toggle._changed = fn
    end

    Btn.MouseButton1Click:Connect(function()
        Toggle:SetValue(not Toggle.Value)
        if Toggle._changed then Toggle._changed(Toggle.Value) end
    end)

    return Toggle, Btn
end

local function CreateKeyPicker(parent,toggle,opts)
    opts = opts or {}
    local KeyBind = Instance.new("TextButton")
    KeyBind.Size = UDim2.new(0,40,0,22)
    KeyBind.Position = UDim2.new(1,-48,0.5,-11)
    KeyBind.BackgroundColor3 = Theme.Section
    KeyBind.Text = opts.Default and opts.Default.Name or ""
    KeyBind.Font = Enum.Font.Gotham
    KeyBind.TextSize = 12
    KeyBind.TextColor3 = Theme.Text
    KeyBind.AutoButtonColor = false
    KeyBind.Parent = parent
    Round(KeyBind,6)
    Stroke(KeyBind)

    local BindValue = opts.Default or nil

    local WaitingForKey = false
    KeyBind.MouseButton1Click:Connect(function()
        KeyBind.Text = "..."
        WaitingForKey = true
    end)

    UserInputService.InputBegan:Connect(function(input)
        if WaitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
            BindValue = input.KeyCode
            KeyBind.Text = BindValue.Name
            WaitingForKey = false
        end
    end)

    toggle.KeyBind = BindValue
    function toggle:GetState()
        return BindValue and UserInputService:IsKeyDown(BindValue)
    end

    return KeyBind
end

-- LIBRARY
local Library = {}
Library.__index = Library

function Library:CreateWindow(info)
    info = info or {}
    local Window = {}
    Window.Tabs = {}

    local Gui = Instance.new("ScreenGui")
    Gui.Name = getgenv().OceanGUIName or "OceanUI"
    Gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    Gui.ResetOnSpawn = false

    local Main = Instance.new("Frame")
    Main.Size = UDim2.fromOffset(600,400)
    Main.Position = UDim2.fromScale(0.5,0.5)
    Main.AnchorPoint = Vector2.new(0.5,0.5)
    Main.BackgroundColor3 = Theme.Background
    Main.Parent = Gui
    Round(Main,18)
    Stroke(Main)

    -- draggable
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    local function update(input)
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Main.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)

    -- HEADER
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1,0,0,48)
    Header.BackgroundTransparency = 1
    Header.Parent = Main

    local Title = Instance.new("TextLabel")
    Title.Text = info.Title or "Ocean GUI"
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 18
    Title.TextColor3 = Theme.Text
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.fromOffset(14,0)
    Title.Size = UDim2.new(1,-20,1,0)
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Header

    -- CONTENT
    local Content = Instance.new("Frame")
    Content.Size = UDim2.new(1,-20,1,-58)
    Content.Position = UDim2.fromOffset(10,52)
    Content.BackgroundTransparency = 1
    Content.Parent = Main

    -- ADD TAB
    function Window:AddTab(name)
        local Tab = {}
        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.fromScale(1,1)
        Holder.BackgroundTransparency = 1
        Holder.Visible = false
        Holder.Parent = Content

        local UIList = Instance.new("UIListLayout")
        UIList.Padding = UDim.new(0,10)
        UIList.HorizontalAlignment = Enum.HorizontalAlignment.Left
        UIList.Parent = Holder

        function Tab:AddLeftGroupbox(title)
            local Groupbox = {}
            local Box = Instance.new("Frame")
            Box.Size = UDim2.fromOffset(260,40)
            Box.BackgroundColor3 = Theme.Section
            Box.Parent = Holder
            Round(Box,14)
            Stroke(Box)

            local Label = Instance.new("TextLabel")
            Label.Text = title
            Label.Font = Enum.Font.GothamBold
            Label.TextSize = 14
            Label.TextColor3 = Theme.Text
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.fromOffset(12,6)
            Label.Size = UDim2.new(1,-24,0,24)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Box

            local List = Instance.new("UIListLayout")
            List.Padding = UDim.new(0,8)
            List.Parent = Box
            List.HorizontalAlignment = Enum.HorizontalAlignment.Left
            List.VerticalAlignment = Enum.VerticalAlignment.Top

            List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                Box.Size = UDim2.fromOffset(260,List.AbsoluteContentSize.Y+14)
            end)

            function Groupbox:AddToggle(flag,opts)
                local t, btn = CreateToggleButton(Box,opts.Text or flag,opts.Default,opts.Callback)
                Toggles[flag] = t

                function t:AddKeyPicker(name,options)
                    return CreateKeyPicker(btn,t,options)
                end

                return t
            end

            function Groupbox:AddButton(text,callback)
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1,-16,0,28)
                Btn.BackgroundColor3 = Theme.Background
                Btn.Text = text or "Button"
                Btn.Font = Enum.Font.Gotham
                Btn.TextSize = 13
                Btn.TextColor3 = Theme.Text
                Btn.AutoButtonColor = false
                Btn.Parent = Box
                Round(Btn,10)
                Stroke(Btn)

                Btn.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)

                return Btn
            end

            function Groupbox:AddSlider(flag,opts)
                opts = opts or {}
                local SliderFrame = Instance.new("Frame")
                SliderFrame.Size = UDim2.fromOffset(240,36)
                SliderFrame.BackgroundTransparency = 1
                SliderFrame.Parent = Box

                local Label = Instance.new("TextLabel")
                Label.Text = opts.Text or flag
                Label.Font = Enum.Font.Gotham
                Label.TextSize = 13
                Label.TextColor3 = Theme.Text
                Label.BackgroundTransparency = 1
                Label.Position = UDim2.fromOffset(0,0)
                Label.Size = UDim2.new(1,-40,0,18)
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = SliderFrame

                local Slider = Instance.new("Frame")
                Slider.Size = UDim2.new(1,0,0,8)
                Slider.Position = UDim2.new(0,0,0,20)
                Slider.BackgroundColor3 = Theme.Stroke
                Slider.Parent = SliderFrame
                Round(Slider,4)

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new(opts.Default or 0,0,1,0)
                Fill.BackgroundColor3 = Theme.Accent
                Fill.Parent = Slider
                Round(Fill,4)

                local function updateValue(x)
                    local size = math.clamp((x - Slider.AbsolutePosition.X)/Slider.AbsoluteSize.X,0,1)
                    Fill.Size = UDim2.new(size,0,1,0)
                    if opts.Callback then opts.Callback(size) end
                end

                Slider.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        updateValue(input.Position.X)
                        local conn
                        conn = UserInputService.InputChanged:Connect(function(move)
                            if move.UserInputType == Enum.UserInputType.MouseMovement then
                                updateValue(move.Position.X)
                            end
                        end)
                        input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End then
                                conn:Disconnect()
                            end
                        end)
                    end
                end)

                Options[flag] = {Value = opts.Default or 0}
                function Options[flag]:OnChanged(fn)
                    self._changed = fn
                end
                return SliderFrame
            end

            return Groupbox
        end

        Window.Tabs[name] = Tab
        if not Window.CurrentTab then
            Window.CurrentTab = Holder
            Holder.Visible = true
        end

        return Tab
    end

    return Window
end

return Library
