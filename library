--[[ 
    OceanUI 🌊
    Linoria-style | Rounded | Toggles + Keybinds
    Draggable, Tab system
]] 

-- SERVICES
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local LP = Players.LocalPlayer

-- GLOBALS
getgenv().Toggles = {}
getgenv().Options = {}
getgenv().GuiName = getgenv().GuiName or "Ocean GUI"

-- THEME
local Theme = {
    Background = Color3.fromRGB(14,18,26),
    Section = Color3.fromRGB(18,24,34),
    Accent = Color3.fromRGB(0,170,255),
    Text = Color3.fromRGB(235,240,245),
    Muted = Color3.fromRGB(120,130,145),
    Stroke = Color3.fromRGB(40,55,80)
}

-- UTILS
local function Round(obj,r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,r)
    c.Parent = obj
end
local function Stroke(obj)
    local s = Instance.new("UIStroke")
    s.Color = Theme.Stroke
    s.Thickness = 1
    s.Parent = obj
end

-- LIB
local Library = {}
Library.__index = Library

-- CREATE WINDOW
function Library:CreateWindow(info)
    info = info or {}
    local Window = {}
    Window.Tabs = {}
    Window.Open = true
    Window.MenuKey = Enum.KeyCode.RightShift

    -- GUI
    local Gui = Instance.new("ScreenGui")
    Gui.Name = getgenv().GuiName
    Gui.ResetOnSpawn = false
    Gui.Parent = LP:WaitForChild("PlayerGui")

    local Main = Instance.new("Frame")
    Main.Size = UDim2.fromOffset(640,420)
    Main.Position = UDim2.fromScale(0.5,0.5)
    Main.AnchorPoint = Vector2.new(0.5,0.5)
    Main.BackgroundColor3 = Theme.Background
    Main.Parent = Gui
    Round(Main,16)
    Stroke(Main)

    -- HEADER
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1,0,0,42)
    Header.BackgroundTransparency = 1
    Header.Parent = Main

    local Title = Instance.new("TextLabel")
    Title.Text = info.Title or getgenv().GuiName
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 17
    Title.TextColor3 = Theme.Text
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.fromOffset(14,0)
    Title.Size = UDim2.new(1,-20,1,0)
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Header

    -- TAB DOTS HOLDER
    local TabHolder = Instance.new("Frame")
    TabHolder.Size = UDim2.new(0,100,0,20)
    TabHolder.Position = UDim2.new(1,-110,0,12)
    TabHolder.BackgroundTransparency = 1
    TabHolder.Parent = Header

    -- DRAG
    do
        local dragging, startPos, dragStart
        Header.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = i.Position
                startPos = Main.Position
                i.Changed:Connect(function()
                    if i.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        Header.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local d = i.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale,startPos.X.Offset+d.X,
                    startPos.Y.Scale,startPos.Y.Offset+d.Y
                )
            end
        end)
    end

    -- TOGGLE MENU
    UIS.InputBegan:Connect(function(i,gp)
        if not gp and i.KeyCode == Window.MenuKey then
            Window.Open = not Window.Open
            Main.Visible = Window.Open
        end
    end)

    -- CONTENT
    local Content = Instance.new("Frame")
    Content.Position = UDim2.fromOffset(10,50)
    Content.Size = UDim2.new(1,-20,1,-60)
    Content.BackgroundTransparency = 1
    Content.Parent = Main

    -- ===== ADD TAB =====
    function Window:AddTab(name)
        local Tab = {}
        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.fromScale(1,1)
        Holder.Visible = false
        Holder.BackgroundTransparency = 1
        Holder.Parent = Content

        -- left/right columns
        local Left = Instance.new("Frame")
        Left.Size = UDim2.new(0.5,-5,1,0)
        Left.BackgroundTransparency = 1
        Left.Parent = Holder
        local Right = Instance.new("Frame")
        Right.Position = UDim2.new(0.5,5,0,0)
        Right.Size = UDim2.new(0.5,-5,1,0)
        Right.BackgroundTransparency = 1
        Right.Parent = Holder

        local function layout(col)
            local l = Instance.new("UIListLayout")
            l.Padding = UDim.new(0,10)
            l.Parent = col
        end
        layout(Left)
        layout(Right)

        -- GROUPBOX CREATOR
        local function createGroupbox(parent,title)
            local Group = {}
            local Box = Instance.new("Frame")
            Box.Size = UDim2.fromOffset(parent.AbsoluteSize.X,40)
            Box.BackgroundColor3 = Theme.Section
            Box.Parent = parent
            Round(Box,14)
            Stroke(Box)

            local Label = Instance.new("TextLabel")
            Label.Text = title
            Label.Font = Enum.Font.GothamBold
            Label.TextSize = 14
            Label.TextColor3 = Theme.Text
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.fromOffset(12,6)
            Label.Size = UDim2.new(1,-24,0,24)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Box

            local List = Instance.new("UIListLayout")
            List.Padding = UDim.new(0,8)
            List.Parent = Box

            List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                Box.Size = UDim2.new(1,0,0,List.AbsoluteContentSize.Y+12)
            end)

            -- TOGGLE + KEYBIND
            function Group:AddToggle(flag,opts)
                opts = opts or {}
                local T = {Value = opts.Default or false}
                Toggles[flag] = T

                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1,-16,0,36)
                Btn.BackgroundColor3 = Theme.Background
                Btn.Text = ""
                Btn.Parent = Box
                Round(Btn,10)
                Stroke(Btn)

                local Txt = Instance.new("TextLabel")
                Txt.Text = opts.Text or flag
                Txt.Font = Enum.Font.Gotham
                Txt.TextSize = 13
                Txt.TextColor3 = Theme.Text
                Txt.BackgroundTransparency = 1
                Txt.Position = UDim2.fromOffset(12,0)
                Txt.Size = UDim2.new(1,-90,1,0)
                Txt.TextXAlignment = Enum.TextXAlignment.Left
                Txt.Parent = Btn

                local Ind = Instance.new("Frame")
                Ind.Size = UDim2.fromOffset(20,20)
                Ind.Position = UDim2.new(1,-32,0.5,-10)
                Ind.BackgroundColor3 = T.Value and Theme.Accent or Theme.Stroke
                Ind.Parent = Btn
                Round(Ind,6)

                function T:SetValue(v)
                    T.Value = v
                    TweenService:Create(Ind,TweenInfo.new(0.15),{BackgroundColor3=v and Theme.Accent or Theme.Stroke}):Play()
                    if opts.Callback then opts.Callback(v) end
                end

                Btn.MouseButton1Click:Connect(function()
                    T:SetValue(not T.Value)
                end)

                -- ADD LINORIA STYLE KEYPICKER
                function T:AddKeyPicker(name,keyinfo)
                    keyinfo = keyinfo or {}
                    local kp = {}
                    kp.Value = keyinfo.Default or ""
                    kp.Mode = keyinfo.Mode or "Toggle"
                    kp.SyncToggleState = keyinfo.SyncToggleState or false

                    local KeyLbl = Instance.new("TextLabel")
                    KeyLbl.Text = kp.Value.Name or ""
                    KeyLbl.Font = Enum.Font.Gotham
                    KeyLbl.TextSize = 11
                    KeyLbl.TextColor3 = Theme.Muted
                    KeyLbl.BackgroundTransparency = 1
                    KeyLbl.Position = UDim2.new(1,-80,0,0)
                    KeyLbl.Size = UDim2.fromOffset(60,36)
                    KeyLbl.TextXAlignment = Enum.TextXAlignment.Right
                    KeyLbl.Parent = Btn

                    UIS.InputBegan:Connect(function(i,gp)
                        if not gp and i.KeyCode == kp.Value then
                            if kp.Mode == "Toggle" then
                                T:SetValue(not T.Value)
                            end
                        end
                    end)

                    return kp
                end

                return T
            end

            return Group
        end

        function Tab:AddLeftGroupbox(name)
            return createGroupbox(Left,name)
        end

        function Tab:AddRightGroupbox(name)
            return createGroupbox(Right,name)
        end

        -- TAB DOT
        local dot = Instance.new("TextButton")
        dot.Size = UDim2.fromOffset(12,12)
        dot.BackgroundColor3 = Theme.Accent
        dot.Text = ""
        dot.Parent = TabHolder
        Round(dot,6)
        dot.MouseButton1Click:Connect(function()
            for _,v in pairs(Content:GetChildren()) do
                v.Visible = false
            end
            Holder.Visible = true
        end)

        Window.Tabs[name] = Holder
        if not Window.Current then
            Window.Current = Holder
            Holder.Visible = true
        end

        return Tab
    end

    return Window
end

return Library
